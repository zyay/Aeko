<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- LAN noVNC / local HTTP. SSH is not HTTP. Public Hugging Face stays HTTPS. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
